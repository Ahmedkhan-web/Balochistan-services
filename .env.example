# ============================================================================
# Balochistan Standard Services (BSS) — Environment Variables
# Copy to `.env` and fill in your values. All client vars must be VITE_ prefixed.
# The app runs in demo mode (local seed data) until Supabase vars are provided.
# ============================================================================

# --- Supabase (backend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Site / contact (optional overrides) ---
VITE_SITE_URL=https://bss.example.com
VITE_COMPANY_EMAIL=info@bss.com.pk
VITE_EMERGENCY_PHONE=+92 300 1234567
VITE_WHATSAPP_NUMBER=923001234567

# --- Integrations (optional) ---
VITE_GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=Quetta,Balochistan&output=embed
VITE_GA_MEASUREMENT_ID=

# --- Server-side only (Supabase Edge Functions / never expose to client) ---
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# JAZZCASH_MERCHANT_ID=
# EASYPAISA_STORE_ID=
# CLOUDINARY_URL=
